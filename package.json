{
  "name": "zaines-stay-and-play",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.5",
  "scripts": {
    "dev": "next dev",
    "build": "sh scripts/vercel-build.sh",
    "start": "next start",
    "lint": "eslint src scripts --ext .ts,.tsx,.js",
    "lint:agents": "node scripts/ci/enforce-agent-autonomy.cjs",
    "auth:readiness": "node scripts/ci/check-auth-readiness.cjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "format:check": "pnpm dlx prettier@3.6.2 --check \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:app && pnpm run test:framework",
    "test:app": "vitest run",
    "test:framework": "pnpm --dir .github/framework test",
    "test:e2e": "PLAYWRIGHT_TEST=1 playwright test",
    "test:e2e:oauth": "PLAYWRIGHT_TEST=1 playwright test tests/oauth-provider-verification.spec.ts",
    "drain:emails": "node scripts/drain-email-queue.js",
    "reminders:run": "tsx scripts/run-reminders.ts",
    "test:watch": "vitest",
    "worker": "node scripts/worker.js",
    "audit:ui:accessibility": "node scripts/audit/accessibility_check.js",
    "audit:admin:auth-health": "node scripts/audit/admin_auth_health_probe.js",
    "audit:ui:accessibility:basic": "node scripts/audit/accessibility_basic_check.js",
    "audit:ui:accessibility:playwright": "node scripts/audit/playwright_a11y.js",
    "audit:issue66:performance": "node scripts/audit/issue66_performance_budget.js",
    "audit:issue66:security": "node scripts/audit/issue66_security_gate.js",
    "audit:issue66:gates": "pnpm run audit:issue66:security && pnpm run audit:issue66:performance && pnpm run audit:ui:accessibility:playwright",
    "audit:issue66:gates:ci": "pnpm run audit:issue66:security && pnpm run audit:issue66:performance && pnpm run audit:ui:accessibility:playwright",
    "audit:rollback:drill": "node scripts/audit/rollback_drill_timing.js",
    "audit:launch:readiness": "node scripts/audit/launch_readiness_evidence.js",
    "audit:launch:readiness:auth": "pnpm audit:admin:auth-health && pnpm audit:launch:readiness",
    "audit:auth-schema-validation": "tsx scripts/audit/auth-schema-validation.ts",
    "audit:auth-diagnose": "tsx scripts/audit/diagnose-production-auth.ts",
    "audit:auth-schema-fix:sql": "node scripts/audit/generate-auth-schema-fix.cjs --raw",
    "audit:preflight": "node scripts/audit/preflight_validation.js",
    "lhci": "lhci autorun",
    "lhci:collect": "lhci collect",
    "lhci:assert": "lhci assert",
    "load:test": "artillery run tests/load/booking-flow.yml",
    "load:test:report": "artillery run --output artillery-report.json tests/load/booking-flow.yml && artillery report artillery-report.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:backfill-waivers": "tsx scripts/backfill-account-waivers.ts",
    "db:normalize-user-emails": "tsx scripts/normalize-user-emails.ts",
    "db:normalize-user-emails:apply": "tsx scripts/normalize-user-emails.ts --apply"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.8.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.8",
    "@stripe/react-stripe-js": "^5.6.1",
    "@stripe/stripe-js": "^8.11.0",
    "@tanstack/react-query": "^5.100.9",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.2.0",
    "flags": "^4.0.6",
    "@vercel/speed-insights": "^2.0.0",
    "bullmq": "^5.76.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.38.0",
    "ioredis": "^5.10.1",
    "lucide-react": "^1.14.0",
    "next": "16.2.6",
    "next-auth": "^5.0.0-beta.31",
    "next-themes": "^0.4.6",
    "pg": "^8.18.0",
    "prisma": "^7.8.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-day-picker": "^9.13.0",
    "react-dom": "19.2.4",
    "react-email": "^5.2.10",
    "react-hook-form": "^7.75.0",
    "resend": "^6.12.3",
    "server-only": "^0.0.1",
    "signature_pad": "^5.1.3",
    "sonner": "^2.0.7",
    "stripe": "^20.4.1",
    "tailwind-merge": "^3.4.0",
    "web-vitals": "^5.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "4.0.18",
    "artillery": "^2.0.31",
    "artillery-plugin-expect": "^2.25.0",
    "axe-core": "^4.11.1",
    "cheerio": "^1.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "happy-dom": "^20.9.0",
    "jsdom": "^29.1.1",
    "shadcn": "^3.8.4",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  },
  "pnpm": {
    "overrides": {
      "hono": "^4.11.7",
      "lodash": "^4.17.23",
      "@types/pg": "8.11.11",
      "undici": "^6.24.0",
      "@auth/core": "0.41.2"
    }
  },
  "overrides": {
    "socket.io-parser": "^4.2.6"
  }
}
