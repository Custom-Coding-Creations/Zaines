// Pawfect Stays - Comprehensive Database Schema
// 22 models covering all features: Authentication, Pets, Services, Bookings, Payments, Reviews, etc.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// AUTHENTICATION & USERS
// ============================================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  address       String?
  city          String?
  state         String?
  zip           String?
  role          String    @default("customer") // customer | staff | admin
  bookingStatusEmailsEnabled Boolean @default(true)
  productUpdatesEmailsEnabled Boolean @default(false)
  marketingEmailsEnabled Boolean @default(false)
  smsNotificationsEnabled Boolean @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  passwordCredential PasswordCredential?
  loginActivities   LoginActivity[]
  pets              Pet[]
  bookings          Booking[]
  accountWaivers    AccountWaiver[]
  reviews           Review[]
  messages          Message[]
  petPhotos         PetPhoto[]
  emergencyContacts EmergencyContact[]
  credits           Credit[]
  claimedBookingTokens BookingClaimToken[] @relation("ClaimedByUser")
  staffProfile      StaffMember?
  customerPackages  CustomerPackage[]
  recurringBookings RecurringBooking[]
  automatedReminders AutomatedReminder[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasswordCredential {
  id                String   @id @default(cuid())
  userId            String   @unique
  passwordHash      String
  passwordUpdatedAt DateTime @default(now())
  failedAttempts    Int      @default(0)
  lockedUntil       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lockedUntil])
  @@map("password_credentials")
}

model LoginActivity {
  id          String   @id @default(cuid())
  userId      String
  eventType   String
  provider    String?
  ipAddress   String?
  userAgent   String?
  isSuspicious Boolean @default(false)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([eventType])
  @@map("login_activities")
}

// ============================================================================
// PET PROFILES & HEALTH
// ============================================================================

model Pet {
  id               String    @id @default(cuid())
  userId           String
  name             String
  breed            String
  age              Int
  weight           Float
  gender           String
  spayedNeutered   Boolean   @default(false)
  microchipId      String?
  imageUrl         String?
  temperament      String? // Friendly, Shy, Aggressive, etc.
  specialNeeds     String? // Allergies, disabilities, etc.
  feedingInstructions String?
  trainingLevel    String? // Basic, Advanced, etc.
  healthNotes      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  vaccines      Vaccine[]
  medications   Medication[]
  weightLogs    WeightLog[]
  bookingPets   BookingPet[]
  activities    Activity[]
  photos        PetPhoto[]
  reportCards   ReportCard[]
  incidentReports IncidentReport[]
  assessments   BehavioralAssessment[]
  playGroupAssignments PlayGroupAssignment[]
  automatedReminders AutomatedReminder[]

  @@index([userId])
  @@map("pets")
}

model Vaccine {
  id            String    @id @default(cuid())
  petId         String
  name          String // Rabies, DHPP, Bordetella, etc.
  administeredDate DateTime
  expiryDate    DateTime
  veterinarian  String?
  documentUrl   String? // PDF upload
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId])
  @@index([expiryDate])
  @@map("vaccines")
}

model Medication {
  id            String    @id @default(cuid())
  petId         String
  name          String
  dosage        String
  frequency     String // Once daily, Twice daily, etc.
  startDate     DateTime
  endDate       DateTime?
  instructions  String?
  prescribedBy  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId])
  @@map("medications")
}

model WeightLog {
  id        String   @id @default(cuid())
  petId     String
  weight    Float
  date      DateTime @default(now())
  notes     String?

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId])
  @@index([date])
  @@map("weight_logs")
}

model EmergencyContact {
  id           String   @id @default(cuid())
  userId       String
  name         String
  relationship String
  phone        String
  email        String?
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("emergency_contacts")
}

// ============================================================================
// SERVICES & SUITES
// ============================================================================

model ServiceType {
  id          String    @id @default(cuid())
  name        String    @unique // Boarding, Daycare, Grooming, Training
  description String?
  icon        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  services Service[]

  @@map("service_types")
}

model Service {
  id            String   @id @default(cuid())
  serviceTypeId String
  name          String // e.g., "Overnight Boarding", "Group Play Daycare"
  description   String?
  price         Float
  duration      Int? // minutes
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  serviceType ServiceType @relation(fields: [serviceTypeId], references: [id])

  @@index([serviceTypeId])
  @@map("services")
}

model Suite {
  id          String   @id @default(cuid())
  name        String // "Deluxe Suite 101", "Standard K-12"
  tier        String // Standard, Deluxe, Luxury
  size        String // Small, Medium, Large
  capacity    Int      @default(1) // Max pets
  pricePerNight Float
  amenities   String[] // Webcam, TV, Raised bed, etc.
  imageUrl    String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookings Booking[]
  recurringBookings RecurringBooking[]

  @@map("suites")
}

model AddOn {
  id          String   @id @default(cuid())
  name        String // Extra Walk, Playtime, Grooming, etc.
  description String?
  price       Float
  duration    Int? // minutes
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookingAddOns BookingAddOn[]

  @@map("add_ons")
}

// ============================================================================
// BOOKINGS & RESERVATIONS
// ============================================================================

model Booking {
  id              String    @id @default(cuid())
  userId          String
  suiteId         String
  packageId       String?
  recurringBookingId String?
  bookingNumber   String    @unique // Auto-generated: PB-20260206-0001
  checkInDate     DateTime
  checkOutDate    DateTime
  totalNights     Int
  subtotal        Float
  tax             Float
  total           Float
  dropoffTimeSlot String?
  pickupTimeSlot  String?
  status          String    @default("pending") // pending, confirmed, checked_in, completed, cancelled
  specialRequests String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user          User                   @relation(fields: [userId], references: [id])
  suite         Suite                  @relation(fields: [suiteId], references: [id])
  package       BookingPackage?        @relation(fields: [packageId], references: [id], onDelete: SetNull)
  recurringBooking RecurringBooking?   @relation(fields: [recurringBookingId], references: [id], onDelete: SetNull)
  bookingPets   BookingPet[]
  bookingAddOns BookingAddOn[]
  waivers       Waiver[]
  payments      Payment[]
  activities    Activity[]
  photos        PetPhoto[]
  messages      Message[]
  photoNotifications PhotoNotification[]
  claimTokens   BookingClaimToken[]
  reportCards   ReportCard[]
  incidentReports IncidentReport[]
  playGroupAssignments PlayGroupAssignment[]
  automatedReminders AutomatedReminder[]

  @@index([userId])
  @@index([suiteId])
  @@index([packageId])
  @@index([recurringBookingId])
  @@index([checkInDate])
  @@index([checkOutDate])
  @@index([status])
  @@map("bookings")
}

model StaffMember {
  id               String   @id @default(cuid())
  userId           String   @unique
  role             String // handler, groomer, manager
  phone            String?
  hireDate         DateTime?
  certifications   String[]
  emergencyContact String?
  notes            String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedules StaffSchedule[]
  reportCards ReportCard[]
  incidentReports IncidentReport[]
  assessments BehavioralAssessment[]
  playGroups PlayGroup[]

  @@index([role])
  @@index([isActive])
  @@map("staff_members")
}

model StaffSchedule {
  id            String   @id @default(cuid())
  staffMemberId String
  date          DateTime
  shiftStart    String
  shiftEnd      String
  breakMinutes  Int      @default(0)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  staffMember StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)

  @@unique([staffMemberId, date, shiftStart, shiftEnd])
  @@index([date])
  @@map("staff_schedules")
}

model ReportCard {
  id            String   @id @default(cuid())
  bookingId     String
  petId         String
  staffMemberId String?
  date          DateTime
  overallMood   String // excellent, good, fair, low
  energyLevel   Int // 1-5
  appetiteLevel String // ate_all, ate_some, didnt_eat
  socialization String // loved_it, warming_up, preferred_alone
  bathroomNotes String?
  playHighlights String?
  behaviorNotes String?
  staffNotes    String?
  sentToOwner   Boolean  @default(false)
  sentAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  pet     Pet     @relation(fields: [petId], references: [id], onDelete: Cascade)
  staffMember StaffMember? @relation(fields: [staffMemberId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([petId])
  @@index([date])
  @@index([sentToOwner])
  @@map("report_cards")
}

model IncidentReport {
  id              String   @id @default(cuid())
  bookingId       String?
  petId           String
  reportedByStaffId String?
  type            String // injury, aggression, health_event, escape_attempt, property_damage
  severity        String // minor, moderate, serious, critical
  description     String
  actionTaken     String?
  vetReferral     Boolean  @default(false)
  vetDetails      String?
  ownerNotified   Boolean  @default(false)
  ownerNotifiedAt DateTime?
  followUpRequired Boolean @default(false)
  followUpNotes   String?
  followUpCompletedAt DateTime?
  photos          String[]
  witnessNames    String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  pet     Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  reportedByStaff StaffMember? @relation(fields: [reportedByStaffId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([petId])
  @@index([type])
  @@index([severity])
  @@index([followUpRequired])
  @@map("incident_reports")
}

model BookingPackage {
  id            String   @id @default(cuid())
  name          String
  type          String // daycare_pass, boarding_bundle, monthly_unlimited
  totalSessions Int
  price         Float
  validDays     Int
  description   String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customerPackages CustomerPackage[]
  bookings Booking[]

  @@index([type])
  @@index([isActive])
  @@map("booking_packages")
}

model CustomerPackage {
  id               String   @id @default(cuid())
  userId           String
  packageId        String
  purchaseDate     DateTime @default(now())
  expiresAt        DateTime
  sessionsUsed     Int      @default(0)
  sessionsRemaining Int
  status           String   @default("active") // active, expired, fully_used, cancelled
  stripePaymentId  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  package BookingPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([packageId])
  @@index([status])
  @@index([expiresAt])
  @@map("customer_packages")
}

model RecurringBooking {
  id              String   @id @default(cuid())
  userId          String
  suiteId         String?
  serviceType     String // daycare, boarding
  daysOfWeek      Int[] // 0=Sun..6=Sat
  startDate       DateTime
  endDate         DateTime?
  isActive        Boolean  @default(true)
  specialRequests String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  suite Suite? @relation(fields: [suiteId], references: [id], onDelete: SetNull)
  generatedBookings Booking[]

  @@index([userId])
  @@index([suiteId])
  @@index([isActive])
  @@map("recurring_bookings")
}

model BehavioralAssessment {
  id                String   @id @default(cuid())
  petId             String
  assessedByStaffId String?
  assessmentDate    DateTime
  reactivityLevel   Int // 1-5
  resourceGuarding  Boolean  @default(false)
  leashBehavior     String // excellent, good, needs_work, reactive
  separationAnxiety String // none, mild, moderate, high
  playStyle         String // rough, gentle, independent, observer
  sizeCompatibility String // small_only, medium_and_small, any
  energyLevel       String // low, moderate, high
  overallResult     String // approved, conditional, denied
  conditions        String?
  notes             String?
  validUntil        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)
  assessedByStaff StaffMember? @relation(fields: [assessedByStaffId], references: [id], onDelete: SetNull)

  @@index([petId])
  @@index([assessmentDate])
  @@index([overallResult])
  @@index([validUntil])
  @@map("behavioral_assessments")
}

model PlayGroup {
  id            String   @id @default(cuid())
  name          String
  date          DateTime
  timeSlot      String
  location      String // yard_a, yard_b, indoor
  maxCapacity   Int
  sizeCategory  String // small, medium, large, mixed
  energyLevel   String // calm, moderate, high
  staffMemberId String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  staffMember StaffMember? @relation(fields: [staffMemberId], references: [id], onDelete: SetNull)
  assignments PlayGroupAssignment[]

  @@index([date])
  @@index([location])
  @@index([staffMemberId])
  @@map("play_groups")
}

model PlayGroupAssignment {
  id            String   @id @default(cuid())
  playGroupId   String
  petId         String
  bookingId     String?
  joinedAt      DateTime @default(now())
  leftAt        DateTime?
  behaviorNotes String?

  playGroup PlayGroup @relation(fields: [playGroupId], references: [id], onDelete: Cascade)
  pet       Pet       @relation(fields: [petId], references: [id], onDelete: Cascade)
  booking   Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@unique([playGroupId, petId])
  @@index([petId])
  @@index([bookingId])
  @@map("play_group_assignments")
}

model HolidaySurcharge {
  id              String   @id @default(cuid())
  name            String
  startDate       DateTime
  endDate         DateTime
  surchargeType   String // flat, percentage
  surchargeAmount Float
  appliesTo       String // boarding, daycare, all
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([startDate])
  @@index([endDate])
  @@index([isActive])
  @@map("holiday_surcharges")
}

model AutomatedReminder {
  id              String   @id @default(cuid())
  type            String // booking_reminder, pickup_reminder, rebook_nudge, vaccine_expiry, assessment_due
  recipientUserId String
  recipientEmail  String
  bookingId       String?
  petId           String?
  scheduledFor    DateTime
  channel         String // email, sms
  sent            Boolean  @default(false)
  sentAt          DateTime?
  createdAt       DateTime @default(now())

  recipientUser User @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  pet Pet? @relation(fields: [petId], references: [id], onDelete: SetNull)

  @@index([recipientUserId])
  @@index([bookingId])
  @@index([petId])
  @@index([scheduledFor])
  @@index([sent])
  @@map("automated_reminders")
}

model TimeSlotConfig {
  id          String   @id @default(cuid())
  dayOfWeek   Int // 0=Sun..6=Sat
  slotStart   String
  slotEnd     String
  maxCapacity Int
  serviceType String // dropoff, pickup, both
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([dayOfWeek])
  @@index([serviceType])
  @@index([isActive])
  @@map("time_slot_configs")
}

model InventoryItem {
  id             String   @id @default(cuid())
  name           String
  category       String // food, treats, cleaning, medical, supplies
  unit           String // bag, bottle, count, lbs, etc
  currentStock   Float
  reorderLevel   Float
  reorderQuantity Float
  costPerUnit    Float?
  supplier       String?
  notes          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  logs InventoryLog[]

  @@index([category])
  @@index([isActive])
  @@map("inventory_items")
}

model InventoryLog {
  id         String   @id @default(cuid())
  itemId      String
  changeType  String // restock, used, adjustment, waste
  quantity    Float
  performedBy String?
  notes       String?
  createdAt   DateTime @default(now())

  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([changeType])
  @@index([createdAt])
  @@map("inventory_logs")
}

model BookingClaimToken {
  id              String   @id @default(cuid())
  bookingId       String
  email           String
  token           String   @unique
  expiresAt       DateTime
  claimedAt       DateTime?
  claimedByUserId String?
  createdAt       DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  claimedByUser User? @relation("ClaimedByUser", fields: [claimedByUserId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([email])
  @@index([expiresAt])
  @@map("booking_claim_tokens")
}

model BookingPet {
  id        String   @id @default(cuid())
  bookingId String
  petId     String
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  pet     Pet     @relation(fields: [petId], references: [id])

  @@unique([bookingId, petId])
  @@index([bookingId])
  @@index([petId])
  @@map("booking_pets")
}

model BookingAddOn {
  id        String   @id @default(cuid())
  bookingId String
  addOnId   String
  quantity  Int      @default(1)
  price     Float
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  addOn   AddOn   @relation(fields: [addOnId], references: [id])

  @@index([bookingId])
  @@index([addOnId])
  @@map("booking_add_ons")
}

model Waiver {
  id               String   @id @default(cuid())
  bookingId        String
  accountWaiverId  String?
  type             String // liability, medical, photo_release
  content          String // Full waiver text
  signature        String // Base64 encoded signature image
  signedAt         DateTime @default(now())
  appliedAt        DateTime @default(now())
  sourceType       String   @default("new_signature")
  ipAddress        String
  userAgent        String?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  accountWaiver AccountWaiver? @relation(fields: [accountWaiverId], references: [id])

  @@index([bookingId])
  @@index([accountWaiverId])
  @@map("waivers")
}

model AccountWaiver {
  id         String   @id @default(cuid())
  userId     String
  type       String // liability, medical, photo_release
  content    String // Full waiver text
  signature  String // Base64 encoded signature image
  signedAt   DateTime @default(now())
  expiresAt  DateTime?
  ipAddress  String
  userAgent  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  waivers  Waiver[]

  @@unique([userId, type])
  @@index([userId])
  @@index([expiresAt])
  @@map("account_waivers")
}

// ============================================================================
// PAYMENTS
// ============================================================================

model Payment {
  id                        String   @id @default(cuid())
  bookingId                 String
  stripePaymentId           String?  @unique
  stripeChargeId            String?  @unique // Distinct from paymentIntentId
  amount                    Float
  currency                  String   @default("usd")
  status                    String // pending, succeeded, failed, refunded, cancelled
  revenueRecognitionMethod  String? // service_period, at_payment, excluded
  recognitionStatus         String? // deferred, partially_recognized, fully_recognized, reversed, voided, excluded
  servicePeriodStart        DateTime?
  servicePeriodEnd          DateTime?
  deferredRevenueAmount     Float?
  recognizedRevenueAmount   Float?
  taxTreatment              String? // booking_taxable, third_party_tax, non_taxable
  passthroughFeeAmount      Float?
  exclusionReason           String?
  recognitionImportedAt     DateTime?
  paymentMethod             String? // card, bank_transfer, etc.
  cardBrand                 String? // Visa, Amex, Discover, etc.
  cardLastFour              String? // e.g., "4242"
  stripeFeeAmount           Float? // Stripe's transaction fee
  stripeBalanceTransactionId String? // For payout matching
  isDeposit                 Boolean  @default(false) // true = deposit, false = full/balance
  paidAt                    DateTime?
  refundedAt                DateTime?
  refundAmount              Float?
  webhookEventIds           String[] // JSON array of Stripe event IDs
  reconciliationStatus      String? // pending, matched, disputed
  reconciliationNote        String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  booking            Booking         @relation(fields: [bookingId], references: [id])
  stripeBalances     StripeBalance[] @relation("PaymentToBalance")
  stripeEvent        StripeEvent?    @relation("PaymentToEvent")

  @@index([bookingId])
  @@index([status])
  @@index([stripePaymentId])
  @@index([stripeChargeId])
  @@index([reconciliationStatus])
  @@index([recognitionStatus])
  @@index([servicePeriodStart])
  @@index([servicePeriodEnd])
  @@map("payments")
}

model Credit {
  id          String   @id @default(cuid())
  userId      String
  amount      Float
  type        String // gift_card, loyalty, refund
  code        String? @unique // For gift cards
  description String?
  balance     Float
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([code])
  @@map("credits")
}

// ============================================================================
// STRIPE INTEGRATION & RECONCILIATION
// ============================================================================

model StripeEvent {
  id        String   @id @default(cuid())
  eventId   String   @unique // Stripe's event ID
  eventType String // payment_intent.succeeded, charge.refunded, etc.
  paymentId String?  @unique // Linked payment if applicable
  payload   Json // Full Stripe event object
  processed Boolean  @default(false)
  processedAt DateTime?
  createdAt DateTime @default(now())

  payment Payment? @relation("PaymentToEvent", fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([eventType])
  @@index([processed])
  @@map("stripe_events")
}

model StripeBalance {
  id                      String   @id @default(cuid())
  balanceTransactionId    String   @unique // Stripe's balance transaction ID
  paymentId               String? // Link to Payment if this is from a charge
  type                    String // charge, refund, payout_reversal, fee, etc.
  amount                  Float // Gross amount
  stripeFee               Float // Stripe's fee (negative for charges, included in gross for refunds)
  net                     Float // Net amount (amount - stripeFee)
  sourceChargeId          String? // If this is a refund, the charge it refunded
  payoutId                String? // Link to StripePayout if this was included in a payout
  payoutArrivalDate       DateTime? // When this will/did arrive in payout
  status                  String // available, pending (processing)
  createdAt               DateTime @default(now())

  payment   Payment?      @relation("PaymentToBalance", fields: [paymentId], references: [id], onDelete: SetNull)
  payout    StripePayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@index([payoutId])
  @@index([status])
  @@map("stripe_balances")
}

model StripePayout {
  id                String   @id @default(cuid())
  stripePayoutId    String   @unique
  amount            Float
  currency          String   @default("usd")
  status            String // pending, in_transit, paid, failed, canceled
  failureCode       String? // If failed, why
  arrivedAt         DateTime? // When the payout actually arrived
  reconciledAt      DateTime? // When admin marked as reconciled
  reconciledByUserId String? // Which admin reconciled it
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  balanceTransactions StripeBalance[]

  @@index([status])
  @@index([reconciledAt])
  @@map("stripe_payouts")
}

// ============================================================================
// ACTIVITY & COMMUNICATIONS
// ============================================================================

model Activity {
  id          String   @id @default(cuid())
  bookingId   String
  petId       String
  type        String // feeding, walk, play, bathroom, medication, grooming
  description String?
  performedBy String? // Staff member name
  performedAt DateTime @default(now())
  notes       String?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  pet     Pet     @relation(fields: [petId], references: [id])

  @@index([bookingId])
  @@index([petId])
  @@index([performedAt])
  @@map("activities")
}

model Message {
  id         String   @id @default(cuid())
  bookingId  String?
  userId     String
  senderType String // customer, staff
  senderName String
  content    String
  isRead     Boolean  @default(false)
  sentAt     DateTime @default(now())

  booking Booking? @relation(fields: [bookingId], references: [id])
  user    User     @relation(fields: [userId], references: [id])

  @@index([bookingId])
  @@index([userId])
  @@index([sentAt])
  @@map("messages")
}

model PetPhoto {
  id          String   @id @default(cuid())
  bookingId   String?
  userId      String
  petId       String
  imageUrl    String
  caption     String?
  uploadedBy  String? // Staff member name
  uploadedAt  DateTime @default(now())
  pushSentAt  DateTime? // When push notification sent to owner

  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pet     Pet     @relation(fields: [petId], references: [id])

  @@index([bookingId])
  @@index([userId])
  @@index([userId, uploadedAt])
  @@index([petId])
  @@index([uploadedAt])
  @@map("pet_photos")
}

// ============================================================================
// REVIEWS & SEO
// ============================================================================

model Review {
  id            String   @id @default(cuid())
  userId        String
  rating        Int // 1-5 stars
  title         String?
  content       String
  isVerified    Boolean  @default(false) // True if they had a booking
  isPublished   Boolean  @default(true)
  staffResponse String? // Optional response from business
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([rating])
  @@index([isPublished])
  @@index([createdAt])
  @@map("reviews")
}

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String?
  content     String // HTML or Markdown
  coverImage  String?
  author      String
  category    String // Tips, News, Events, Guides
  tags        String[]
  metaTitle   String?
  metaDescription String?
  isPublished Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([category])
  @@index([isPublished])
  @@index([publishedAt])
  @@map("blog_posts")
}

// ============================================================================
// CONFIGURATION
// ============================================================================

model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ============================================================================
// NOTIFICATIONS
// ============================================================================

model PhotoNotification {
  id           String   @id @default(cuid())
  photoId      String
  bookingId    String
  ownerEmail   String
  petName      String
  type         String // 'instant' | 'daily_batch'
  scheduledFor DateTime
  sent         Boolean  @default(false)
  sentAt       DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([sent])
  @@index([scheduledFor])
  @@map("photo_notifications")
}
