# ============================================================================
# Pawfect Stays - Environment Variables Configuration
# ============================================================================
#
# IMPORTANT: After cloning or updating the Prisma schema, run:
#   npm run prisma:generate
#
# This generates the TypeScript client for database operations.
# The app will start without these variables but features requiring them
# will return clear error messages.
#
# ============================================================================

# Database Configuration
# PostgreSQL connection string
# Example: postgresql://username:password@localhost:5432/pawfect_stays
DATABASE_URL="postgresql://user:password@localhost:5432/pawfect_stays"

# NextAuth.js v5 Configuration
# AUTH_SECRET is the canonical variable name for NextAuth v5 (Auth.js).
# NEXTAUTH_SECRET is the legacy name and is supported as a fallback.
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# AUTH_URL is the canonical variable name for NextAuth v5.
# NEXTAUTH_URL is the legacy name and may still be required by some adapters.
# Set to the publicly accessible base URL of your deployment.
AUTH_URL="http://localhost:3000"

# Optional: enable database-backed auth sessions and email magic links.
# Keep false to use stateless JWT sessions (recommended default for resiliency).
AUTH_ENABLE_DATABASE_SESSIONS="false"

# Legacy aliases kept for backward-compatibility (will be removed in a future release)
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Stripe Payment Configuration
# Get your keys from https://dashboard.stripe.com/apikeys
# Use test mode keys (starting with pk_test_ and sk_test_) for development
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key_here"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key_here"

# Stripe Webhook Secret
# Get from https://dashboard.stripe.com/webhooks after creating a webhook endpoint
# Use the test mode webhook secret for development
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret_here"

# Stripe Event Destination Webhook Secrets (Snapshot + Thin)
# Use separate webhook endpoints/secrets per payload style in Stripe Workbench.
# Keep STRIPE_WEBHOOK_SECRET mapped to your active Snapshot endpoint for current code paths.
STRIPE_WEBHOOK_SECRET_SNAPSHOT="whsec_snapshot_placeholder_6f3d9b1a2c4e7d8f"
STRIPE_WEBHOOK_SECRET_THIN="whsec_thin_placeholder_9a4c2e7b1d6f3c8e"

# Email Configuration
# Email address to send emails from
EMAIL_FROM="info@zainesstayandplay.com"

# Email Forwarding Setup
# info@zainesstayandplay.com forwards to david@customcodingcreations.com
# Configure via Cloudflare Email Routing: https://dash.cloudflare.com/

# Email Sending via Cloudflare Worker
# URL of the deployed Cloudflare Worker for sending emails
# Deploy the worker first: cd workers/email-sender && pnpm run deploy
EMAIL_WORKER_URL="https://zaines-email-sender.YOUR-SUBDOMAIN.workers.dev"
# Secret key for authenticating with the email worker
# Generate with: openssl rand -base64 32
EMAIL_WORKER_SECRET="your-worker-secret-key-here"

# Optional: Resend API Key (legacy - use Cloudflare Worker instead)
# If not set, emails will be queued locally in tmp/email-queue.log
# DEPRECATED: Prefer EMAIL_WORKER_URL and EMAIL_WORKER_SECRET above
# Get from https://resend.com/api-keys
RESEND_API_KEY=""

# Google OAuth (Optional)
# Get from https://console.cloud.google.com/apis/credentials
# Only required if you want to enable Google sign-in
# Preferred key names for Auth.js v5 are AUTH_GOOGLE_CLIENT_ID / AUTH_GOOGLE_CLIENT_SECRET.
# Legacy GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET are still supported as fallback.
AUTH_GOOGLE_CLIENT_ID="your_google_client_id_here.apps.googleusercontent.com"
AUTH_GOOGLE_CLIENT_SECRET="your_google_client_secret_here"
GOOGLE_CLIENT_ID="your_google_client_id_here.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"

# Facebook OAuth (Optional)
# Get from https://developers.facebook.com/apps/
# Only required if you want to enable Facebook sign-in
# CRITICAL: Replace these with actual values from your Facebook App Dashboard.
# Do NOT deploy to production with placeholder values ("your_facebook_app_id_here").
# If you don't have a Facebook app, leave these unset and Facebook sign-in will be disabled.
FACEBOOK_CLIENT_ID="your_facebook_app_id_here"
FACEBOOK_CLIENT_SECRET="your_facebook_app_secret_here"

# Node Environment
# Set to 'development' for local development, 'production' for production
NODE_ENV="development"
